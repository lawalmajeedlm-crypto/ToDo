@model ToDo.Models.ToDoItem

<h1>Task Details</h1>
<dl class="row">
    <dt class="col-sm-2">
        Title
    </dt>
    <dd class="col-sm-10">
        @Model.Title
    </dd>
    <dt class="col-sm-2">
        Description
    </dt>
    <dd class="col-sm-10">
        @Model.Description
    </dd>
    <dt class="col-sm-2">
        Is Completed
    </dt>
    <dd class="col-sm-10">
        @(Model.IsCompleted ? "Yes" : "No")
    </dd>
    <dt class="col-sm-2">
        Created At
    </dt>
    <dd class="col-sm-10">
        @Model.CreatedAt.ToString("yyyy-MM-dd")
    </dd>
</dl>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>